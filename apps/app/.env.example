# ─────────────────────────────────────────────────────────────────────────────
# SoverMind Frontend — Environment Variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Vercel deployment, set these in the Vercel dashboard under
# Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Demo Mode ────────────────────────────────────────────────────────────────
# Set to "true" on Vercel so judges see a working UI without a local backend.
# The app will use simulated QVAC responses and show the demo banner.
# Set to "false" for local dev with the real QVAC backend running.
VITE_DEMO_MODE=false

# ── Solana / Smart Contract ──────────────────────────────────────────────────
# Program ID printed by `anchor deploy` in contract/
# (already pre-filled with the deployed devnet program)
VITE_PROGRAM_ID=Gyk1UsWrmo2W3p4LGTyyFbsXCWwsocKVc8X3tdDaJXJ4

# Treasury wallet that receives the 0.50 USDT micro-payment.
# Generate one with: solana-keygen new --outfile treasury.json
VITE_TREASURY_PUBKEY=<your-treasury-wallet-pubkey>

# Official Tether USDT devnet mint address (do not change)
VITE_USDT_MINT_DEVNET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ── Branding ─────────────────────────────────────────────────────────────────
# GitHub repo URL shown in the demo banner "DOWNLOAD FOR REAL LOCAL AI →" link
VITE_GITHUB_URL=https://github.com/Gokul-social/Sovermind
