PORT=3001
HOST=127.0.0.1

# Model paths — download models and point these at the .gguf / .bin / .onnx files
LLM_MODEL_PATH=./models/llm/mistral-7b-instruct.gguf
WHISPER_MODEL_PATH=./models/whisper/ggml-base.bin
OCR_MODEL_PATH=./models/ocr/ocr-model.onnx
TRANSLATION_MODEL_PATH=./models/translation/

# Inference config
MAX_TOKENS=1024
CONTEXT_WINDOW=4096
LLM_TEMPERATURE=0.7

# Vault
VAULT_PATH=~/.sovermind/vault.json

# Logging (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# Security — only this origin is allowed to connect
ALLOWED_ORIGIN=http://localhost:5173
